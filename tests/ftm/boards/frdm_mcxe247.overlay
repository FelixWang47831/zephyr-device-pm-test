&pinctrl {
	ftm0_default: ftm0_default {
		group0 {
			pinmux = <FTM0_CH0_PTD15>;
			drive-strength = "low";
			slew-rate = "slow";
		};
	};
};

&ftm0 {
	status = "okay";
	compatible = "nxp,ftm-pwm";
	clock-source = "external";
	prescaler = <128>;
	#pwm-cells = <3>;
	pinctrl-0 = <&ftm0_default>;
	pinctrl-names = "default";
};

/*
 * MCXE24x leaves lptmr0 disabled and unmarked, so without this the sysmanaged
 * layer would have no timed wake source and the forced Deep Sleep would never
 * end.
 */
&lptmr0 {
	status = "okay";
	wakeup-source;
};

/ {
	chosen {
		zephyr,system-timer-companion = &lptmr0;
	};
};
